+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { STORE_KEYS } from "@/lib/local-store";
+import { clearUserCaches, prepareSignOut, unsubscribePush, warmPages } from "./client";
+
+function fakeLocalStorage() {
+  const map = new Map<string, string>();
+  return {
+    map,
+    getItem: (k: string) => map.get(k) ?? null,
+    setItem: (k: string, v: string) => void map.set(k, v),
+    removeItem: (k: string) => void map.delete(k),
+  };
+}
+
+let posted: unknown[];
+let deleted: string[];
+let unsubscribe: ReturnType<typeof vi.fn>;
+let storage: ReturnType<typeof fakeLocalStorage>;
+let cookies: string[];
+
+function install({ controller = true, hangPush = false } = {}) {
+  unsubscribe = vi.fn(() => (hangPush ? new Promise(() => {}) : Promise.resolve(true)));
+  vi.stubGlobal("navigator", {
+    serviceWorker: {
+      controller: controller ? { postMessage: (m: unknown) => posted.push(m) } : null,
+      getRegistration: async () => ({
+        pushManager: { getSubscription: async () => ({ unsubscribe }) },
+      }),
+    },
+  });
+  vi.stubGlobal("caches", { delete: async (name: string) => (deleted.push(name), true) });
+  vi.stubGlobal("location", { origin: "https://adamsrealty.example", protocol: "https:" });
+  vi.stubGlobal("window", {
+    localStorage: storage,
+    location: { protocol: "https:" },
+    addEventListener() {},
+    removeEventListener() {},
+  });
+  vi.stubGlobal("document", {
+    set cookie(c: string) {
+      cookies.push(c);
+    },
+  });
+}
+
+beforeEach(() => {
+  posted = [];
+  deleted = [];
+  cookies = [];
+  storage = fakeLocalStorage();
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+describe("without browser APIs", () => {
+  it("never throws", async () => {
+    vi.stubGlobal("navigator", {});
+    await expect(unsubscribePush()).resolves.toBeUndefined();
+    await expect(clearUserCaches()).resolves.toBeUndefined();
+    await expect(prepareSignOut()).resolves.toBeUndefined();
+    expect(warmPages(["/homes/a"])).toBe(false);
+  });
+});
+
+describe("clearUserCaches", () => {
+  it("deletes user caches, tells the SW and clears recents with the cookie", async () => {
+    install();
+    storage.setItem(STORE_KEYS.recentlyViewed, "[]");
+    storage.setItem(STORE_KEYS.lastSearch, JSON.stringify({ href: "/homes?q=A", at: 1 }));
+    storage.setItem(STORE_KEYS.uid, "abc");
+    await clearUserCaches();
+    expect(deleted.sort()).toEqual(["images", "pages"]);
+    expect(posted).toEqual([{ type: "CLEAR_USER_DATA" }]);
+    expect(storage.map.has(STORE_KEYS.recentlyViewed)).toBe(false);
+    expect(storage.map.has(STORE_KEYS.lastSearch)).toBe(false);
+    // The user marker belongs to the PWA runtime, which rewrites it itself.
+    expect(storage.map.get(STORE_KEYS.uid)).toBe("abc");
+    expect(cookies.at(-1)).toMatch(/^ar_last_search=; .*Max-Age=0.*; Secure$/);
+  });
+});
+
+describe("prepareSignOut", () => {
+  it("unsubscribes push, then clears caches", async () => {
+    install();
+    await prepareSignOut();
+    expect(unsubscribe).toHaveBeenCalledOnce();
+    expect(deleted).toHaveLength(2);
+  });
+
+  it("still clears local data within 1500ms when push hangs", async () => {
+    vi.useFakeTimers();
+    install({ hangPush: true });
+    let done = false;
+    void prepareSignOut().then(() => (done = true));
+    await vi.advanceTimersByTimeAsync(1_000);
+    expect(posted).toEqual([{ type: "CLEAR_USER_DATA" }]);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(done).toBe(true);
+    expect(deleted).toHaveLength(2);
+  });
+});
+
+describe("warmPages", () => {
+  it("posts same-origin allowlisted paths, deduplicated, at most 50", () => {
+    install();
+    const urls = [
+      "/homes/a",
+      "https://adamsrealty.example/homes/a",
+      "/dashboard",
+      "https://evil.example/homes/b",
+      "/account",
+      ...Array.from({ length: 60 }, (_, i) => `/homes/h-${i}`),
+    ];
+    expect(warmPages(urls)).toBe(true);
+    const msg = posted[0] as { type: string; urls: string[] };
+    expect(msg.type).toBe("CACHE_PAGES");
+    expect(msg.urls).toHaveLength(50);
+    expect(msg.urls[0]).toBe("/homes/a");
+    expect(msg.urls).not.toContain("/dashboard");
+    expect(msg.urls.every((u) => u.startsWith("/homes/"))).toBe(true);
+  });
+
+  it("is a no-op without a controller", () => {
+    install({ controller: false });
+    expect(warmPages(["/homes/a"])).toBe(false);
+    expect(posted).toEqual([]);
+  });
+});
diff --git a/src/lib/pwa/client.ts b/src/lib/pwa/client.ts
new file mode 100644
index 0000000..9d750d1
--- /dev/null
+++ b/src/lib/pwa/client.ts
@@ -0,0 +1,101 @@
+import { clearRecents } from "@/lib/search/recent";
+import { isCacheablePage, LIMITS, SW_MESSAGES, type SwMessage, USER_CACHES } from "./protocol";
+
+/**
+ * Page-side PWA helpers. Every function is safe without a service worker,
+ * Cache Storage or Push (insecure origins, old browsers, private mode) and
+ * never throws.
+ */
+
+function sw(): ServiceWorkerContainer | undefined {
+  return typeof navigator === "undefined" ? undefined : navigator.serviceWorker;
+}
+
+function post(message: SwMessage): boolean {
+  const controller = sw()?.controller;
+  if (!controller) return false;
+  try {
+    controller.postMessage(message);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function capped(work: Promise<unknown>, ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    const timer = setTimeout(resolve, ms);
+    work.then(
+      () => (clearTimeout(timer), resolve()),
+      () => (clearTimeout(timer), resolve()),
+    );
+  });
+}
+
+/**
+ * Drops this device's push subscription. Needs no session: the server row
+ * gets a 410 on its next send and is deleted then.
+ */
+export async function unsubscribePush(): Promise<void> {
+  try {
+    const reg = await sw()?.getRegistration();
+    const sub = await reg?.pushManager?.getSubscription();
+    await sub?.unsubscribe();
+  } catch {
+    // No SW, no push support, or already gone.
+  }
+}
+
+/**
+ * Forgets this user's local data: recents (and the last-search cookie), the
+ * pages and images caches, and tells the SW to do the same.
+ */
+export async function clearUserCaches(): Promise<void> {
+  try {
+    clearRecents();
+  } catch {
+    // Storage unavailable: nothing stored.
+  }
+  post({ type: SW_MESSAGES.CLEAR_USER_DATA });
+  try {
+    if (typeof caches !== "undefined") {
+      await Promise.all(USER_CACHES.map((name) => caches.delete(name)));
+    }
+  } catch {
+    // Cache Storage unavailable.
+  }
+}
+
+/**
+ * Run before authClient.signOut() (and on a user change): unsubscribePush(),
+ * then clearUserCaches(), within `maxMs` total so sign-out never hangs. A
+ * stuck push service gets at most two thirds of the budget, so local data is
+ * still cleared; recents and the SW message go out synchronously in any case.
+ */
+export async function prepareSignOut(maxMs = 1500): Promise<void> {
+  const started = Date.now();
+  await capped(unsubscribePush(), (maxMs * 2) / 3);
+  await capped(clearUserCaches(), Math.max(0, maxMs - (Date.now() - started)));
+}
+
+/**
+ * Asks the SW to cache these pages for offline use (e.g. saved homes). Only
+ * same-origin PAGE_ALLOW URLs are sent, deduplicated, at most 50. Returns
+ * false (a no-op) without an active SW controller.
+ */
+export function warmPages(urls: readonly string[]): boolean {
+  if (!sw()?.controller || typeof location === "undefined") return false;
+  const origin = location.origin;
+  const paths = new Set<string>();
+  for (const u of urls) {
+    if (paths.size >= LIMITS.warmPages) break;
+    try {
+      const url = new URL(u, origin);
+      if (isCacheablePage(url, origin)) paths.add(url.pathname + url.search);
+    } catch {
+      // Skip malformed URLs.
+    }
+  }
+  if (!paths.size) return false;
+  return post({ type: SW_MESSAGES.CACHE_PAGES, urls: [...paths] });
+}
