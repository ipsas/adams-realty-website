+import { describe, expect, it } from "vitest";
+import { site } from "@/config/site";
+import {
+  estimateMonthlyCost,
+  type FinanceDefaults,
+  monthlyCostModel,
+  monthlyHoaAmount,
+  quickMonthlyCost,
+} from "./mortgage";
+
+/** The listing page's full estimate, with the site's finance defaults. */
+function fullEstimate(
+  l: {
+    price: number;
+    annualTax: number | null;
+    hoaFee: number | null;
+    hoaFrequency: string | null;
+  },
+  f: FinanceDefaults = site.finance,
+) {
+  return estimateMonthlyCost({
+    price: l.price,
+    downPaymentPct: f.downPaymentPct,
+    interestRatePct: f.interestRate,
+    loanTermYears: f.loanTermYears,
+    annualTax: l.annualTax || (l.price * f.propertyTaxRatePct) / 100,
+    annualInsurance: (l.price * f.insuranceRatePct) / 100,
+    monthlyHoa: monthlyHoaAmount(l.hoaFee, l.hoaFrequency),
+  }).total;
+}
+
+const FIXTURES = [
+  { price: 425_000, annualTax: 4_870, hoaFee: null, hoaFrequency: null },
+  { price: 289_900, annualTax: null, hoaFee: 900, hoaFrequency: "quarterly" },
+  { price: 1_250_000, annualTax: 14_200, hoaFee: 2_400, hoaFrequency: "annually" },
+];
+
+describe("quickMonthlyCost", () => {
+  it.each(FIXTURES)("matches estimateMonthlyCost within $1 for $price", (l) => {
+    expect(Math.abs(quickMonthlyCost(l)! - fullEstimate(l))).toBeLessThan(1);
+  });
+
+  it("includes PMI below 20% down with a custom model", () => {
+    const finance = { ...site.finance, downPaymentPct: 5 };
+    const model = monthlyCostModel(finance);
+    expect(model.pmiRateMonthly).toBeGreaterThan(0);
+    for (const l of FIXTURES) {
+      expect(Math.abs(quickMonthlyCost(l, model)! - fullEstimate(l, finance))).toBeLessThan(1);
+    }
+  });
+
+  it("treats a zero tax figure as missing, like the payment calculator", () => {
+    const base = { price: 400_000, hoaFee: null, hoaFrequency: null };
+    expect(quickMonthlyCost({ ...base, annualTax: 0 })).toBe(
+      quickMonthlyCost({ ...base, annualTax: null }),
+    );
+  });
+
+  it("returns null without a price", () => {
+    expect(quickMonthlyCost({ price: 0 })).toBeNull();
+    expect(quickMonthlyCost({ price: null })).toBeNull();
+  });
+});
+
+describe("monthlyCostModel", () => {
+  it("has no PMI at 20% down and scales linearly with price", () => {
+    const m = monthlyCostModel();
+    expect(m.pmiRateMonthly).toBe(0);
+    expect(m.insuranceRateMonthly).toBeCloseTo(site.finance.insuranceRatePct / 1200, 10);
+    expect(m.taxFallbackRateMonthly).toBeCloseTo(site.finance.propertyTaxRatePct / 1200, 10);
+    const a = quickMonthlyCost({ price: 300_000 })!;
+    const b = quickMonthlyCost({ price: 600_000 })!;
+    expect(b).toBeCloseTo(a * 2, 6);
+  });
+});
diff --git a/src/lib/mortgage.ts b/src/lib/mortgage.ts
index 72bcdf7..b18459a 100644
--- a/src/lib/mortgage.ts
+++ b/src/lib/mortgage.ts
@@ -1,3 +1,5 @@
+import { site } from "@/config/site";
+
 /** Monthly principal & interest for a fixed-rate loan. */
 export function monthlyPrincipalAndInterest(
   principal: number,
@@ -70,3 +72,74 @@ export function monthlyHoaAmount(
   if (frequency === "annually") return fee / 12;
   return fee;
 }
+
+/** The subset of `site.finance` the cost model needs. */
+export type FinanceDefaults = {
+  interestRate: number;
+  downPaymentPct: number;
+  loanTermYears: number;
+  insuranceRatePct: number;
+  propertyTaxRatePct: number;
+};
+
+/**
+ * Linear coefficients of the all-in monthly cost, per dollar of price, under
+ * fixed finance defaults. Monthly cost = price × (piPerDollar +
+ * insuranceRateMonthly + pmiRateMonthly) + tax + HOA, where tax falls back to
+ * price × taxFallbackRateMonthly. Cards, pins and (later) the SQL maxMonthly
+ * filter all use these numbers so they agree to the dollar.
+ */
+export type MonthlyCostModel = {
+  /** Principal & interest per dollar of price (the down payment is already applied). */
+  piPerDollar: number;
+  insuranceRateMonthly: number;
+  /** Used when a listing has no tax figure. */
+  taxFallbackRateMonthly: number;
+  /** PMI per dollar of price; 0 at 20% down or more. */
+  pmiRateMonthly: number;
+};
+
+export function monthlyCostModel(finance: FinanceDefaults = site.finance): MonthlyCostModel {
+  const loanPerDollar = Math.max(0, 1 - finance.downPaymentPct / 100);
+  return {
+    piPerDollar: monthlyPrincipalAndInterest(
+      loanPerDollar,
+      finance.interestRate,
+      finance.loanTermYears,
+    ),
+    insuranceRateMonthly: finance.insuranceRatePct / 100 / 12,
+    taxFallbackRateMonthly: finance.propertyTaxRatePct / 100 / 12,
+    // Same rule as estimateMonthlyCost: 0.5%/yr of the loan below 20% down.
+    pmiRateMonthly: finance.downPaymentPct < 20 ? (loanPerDollar * 0.005) / 12 : 0,
+  };
+}
+
+const defaultModel = monthlyCostModel();
+
+/**
+ * All-in monthly cost of buying a for-sale listing with site finance defaults
+ * (unrounded; format with formatMonthly). Callers skip rentals and sold homes.
+ * Matches estimateMonthlyCost; like the payment calculator, a missing or zero
+ * tax figure uses the fallback rate. Null without a price.
+ */
+export function quickMonthlyCost(
+  listing: {
+    price: number | null | undefined;
+    annualTax?: number | null;
+    hoaFee?: number | null;
+    hoaFrequency?: string | null;
+  },
+  model: MonthlyCostModel = defaultModel,
+): number | null {
+  const { price } = listing;
+  if (!price || price <= 0) return null;
+  const tax =
+    listing.annualTax && listing.annualTax > 0
+      ? listing.annualTax / 12
+      : price * model.taxFallbackRateMonthly;
+  return (
+    price * (model.piPerDollar + model.insuranceRateMonthly + model.pmiRateMonthly) +
+    tax +
+    monthlyHoaAmount(listing.hoaFee, listing.hoaFrequency)
+  );
+}
