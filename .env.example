# Copy to .env.local for local development, then uncomment what you need.
# Keep unused lines commented out: an empty value is not the same as unset, and
# src/lib/env.ts only falls back to its dev defaults for unset variables.

# Postgres. The default matches docker-compose.yml.
DATABASE_URL=postgres://adams:adams@localhost:5432/adams_realty

# Required in production: 32+ random characters.
# BETTER_AUTH_SECRET=

# Public origin. On Vercel this falls back to the deployment URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bearer token that Vercel Cron (or any scheduler) sends to /api/cron/*.
# CRON_SECRET=

# Email via Resend. Without RESEND_API_KEY, no email is sent (one redacted log line per attempt).
# RESEND_API_KEY=
# EMAIL_FROM=Adams Realty <hello@example.com>
# Reply-To address for emails that don't set their own. Unset: replies go to EMAIL_FROM.
# EMAIL_REPLY_TO=
# Where new-lead notifications go when a lead has no assigned agent.
# LEADS_INBOX=

# Vercel preview builds only: load demo data. SEED_PASSWORD is the demo-login password.
# SEED_DEMO_DATA=1
# SEED_PASSWORD=

# Demo-data mode: while the site shows sample listings (on search, listing, area, places
# and agent pages), tell search engines to stay off them (noindex, robots.txt, sitemaps).
# Unset, it is ON exactly when SEED_DEMO_DATA=1. Set to off on launch day (HANDOFF.md,
# launch checklist).
# DEMO_DATA_MODE=off

# Listing indexing: "area" (default when unset) lets search engines index the firm's own
# listings and live listings in its area, and lists only those in the listing sitemaps;
# "none" puts noindex on every listing page and lists no listing sitemaps. Any other
# value means "none". Read per request, so changing it needs no rebuild.
# LISTINGS_INDEXING=area

# Preview gate: while set, the whole site is behind this shared password. Visitors without
# it see only the coming-soon page (/preview), which unlocks this browser for 60 days.
# Changing it signs every browser out of the preview. Unset or empty: the site is open.
# Remove it on launch day, together with DEMO_DATA_MODE=off (HANDOFF.md, launch checklist).
# PREVIEW_PASSWORD=

# Georgia MLS IDX feed (Bridge RESO Web API). Without the token the sync skips the feed
# and Dashboard → MLS feeds says which variable is missing. Never commit a real token.
# MLS_GAMLS_TOKEN=
# Bridge dataset name; no default (e.g. "test" for Bridge's demo data).
# MLS_GAMLS_DATASET=test
# Feed geography: statewide (default) or area (the firm's counties, plus Braselton and
# Hoschton in Barrow). Either way the feed only carries live listings (active, coming soon,
# under contract, pending). Changing it resets the sync cursor. Any other value is an error.
# MLS_GAMLS_SCOPE=statewide
# Georgia MLS office ID (ListOfficeMlsId). Statewide: limits the feed to this office's
# listings. Area: adds this office's listings outside the area (it widens the feed).
# MLS_GAMLS_OFFICE_ID=

# The office's internet addresses (comma-separated; ranges like 203.0.113.0/28 or, for
# IPv6, the office's 2001:db8:1:2::/64 allowed). The listing rate limiter never limits
# them. Empty by default.
# OFFICE_IPS=

# Map styles (any MapLibre style URL). Unset: OpenFreeMap positron (light) and dark.
# A custom light style is also used in dark unless a dark one is set, so a custom
# provider is never bypassed.
# NEXT_PUBLIC_MAP_STYLE_URL=
# NEXT_PUBLIC_MAP_STYLE_DARK_URL=
